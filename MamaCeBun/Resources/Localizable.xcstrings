    "Notele de pe server nu au putut fi șterse. Verifică conexiunea la internet și încearcă din nou.": {
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Notele de pe server nu au putut fi șterse. Verifică conexiunea la internet și încearcă din nou."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your ratings couldn’t be deleted from the server. Check your internet connection and try again."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az értékeléseket nem sikerült törölni a szerverről. Ellenőrizd az internetkapcsolatot, és próbáld újra."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Bewertungen konnten nicht vom Server gelöscht werden. Prüfe deine Internetverbindung und versuche es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de supprimer vos notes du serveur. Vérifiez votre connexion Internet et réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile eliminare i voti dal server. Controlla la connessione a Internet e riprova."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron eliminar las notas del servidor. Comprueba tu conexión a internet e inténtalo de nuevo."
          }
        }
      }
    },
    "Notele și comentariile tale dispar de pe acest telefon și de pe server.": {
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Notele și comentariile tale dispar de pe acest telefon și de pe server."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your ratings and comments will be removed from this phone and from the server."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az értékeléseid és hozzászólásaid eltűnnek erről a telefonról és a szerverről."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Bewertungen und Kommentare werden von diesem Telefon und vom Server entfernt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos notes et commentaires seront supprimés de ce téléphone et du serveur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi voti e commenti verranno rimossi da questo telefono e dal server."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus notas y comentarios se eliminarán de este teléfono y del servidor."
          }
        }
      }
    },

    "Am primit propunerea. După ce o verificăm, localul apare în aplicație.": {
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Am primit propunerea. După ce o verificăm, localul apare în aplicație."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We got your suggestion. Once we've checked it, the place will appear in the app."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Megkaptuk a javaslatot. Ellenőrzés után a hely megjelenik az alkalmazásban."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir haben deinen Vorschlag erhalten. Nach der Prüfung erscheint das Lokal in der App."

    "Localurile sunt alese din recenzii publice, ghiduri și presă; sursele sunt în fișa fiecărui local.": {
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Localurile sunt alese din recenzii publice, ghiduri și presă; sursele sunt în fișa fiecărui local."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Places are chosen from public reviews, guides and press; the sources are listed on each place’s page."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A helyeket nyilvános értékelések, útikalauzok és sajtócikkek alapján válogatjuk; a források minden hely adatlapján megtalálhatók."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Lokale werden anhand öffentlicher Bewertungen, Reiseführer und Presse ausgewählt; die Quellen stehen auf der Seite jedes Lokals."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les adresses sont choisies à partir d’avis publics, de guides et de la presse ; les sources figurent sur la fiche de chaque lieu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I locali sono scelti da recensioni pubbliche, guide e stampa; le fonti sono nella scheda di ogni locale."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los locales se eligen a partir de reseñas públicas, guías y prensa; las fuentes están en la ficha de cada local."
          }
        }
      }
    },

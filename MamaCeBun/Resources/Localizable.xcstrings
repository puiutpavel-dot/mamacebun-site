    "Nu vei mai vedea niciun comentariu de la el. Poți anula din „Despre aplicație”.": {
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu vei mai vedea niciun comentariu de la el. Poți anula din „Despre aplicație”."
          }
        },

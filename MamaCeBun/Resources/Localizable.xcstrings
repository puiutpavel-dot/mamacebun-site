    "Fierbinte, dreasă cu usturoi și smântână — și pentru a doua zi": {
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fierbinte, dreasă cu usturoi și smântână — și pentru a doua zi"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hot tripe soup with garlic and sour cream — the classic morning-after cure"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Forró pacalleves fokhagymával és tejföllel — másnaposság ellen is"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Heiße Kuttelsuppe mit Knoblauch und Schmand — auch für den Morgen danach"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Soupe de tripes bien chaude, à l'ail et à la crème — idéale le lendemain"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Zuppa di trippa bollente con aglio e panna acida — perfetta anche il giorno dopo"

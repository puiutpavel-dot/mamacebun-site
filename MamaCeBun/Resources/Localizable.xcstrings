        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tick “Been there” once you've had a taste."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kóstolás után pipáld ki a „Voltam itt” gombot."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hake „War schon da“ ab, sobald du probiert hast."

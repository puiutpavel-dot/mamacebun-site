    "Nota ta rămâne doar pe acest telefon. Media tuturor utilizatorilor vine într-o versiune viitoare.": {
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nota ta rămâne doar pe acest telefon. Media tuturor utilizatorilor vine într-o versiune viitoare."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your rating stays on this phone only. The average from all users is coming in a future version."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A pontszámod csak ezen a telefonon marad. Az összes felhasználó átlaga egy későbbi verzióban érkezik."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Note bleibt nur auf diesem Telefon. Der Durchschnitt aller Nutzer kommt in einer späteren Version."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta note reste uniquement sur ce téléphone. La moyenne de tous les utilisateurs arrive dans une prochaine version."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo voto resta solo su questo telefono. La media di tutti gli utenti arriverà in una versione futura."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu nota se queda solo en este teléfono. La media de todos los usuarios llegará en una versión futura."
          }
        }
      }
    },
    "Nota și comentariul tău intră în media comunității, fără numele tău.": {
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nota și comentariul tău intră în media comunității, fără numele tău."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your rating and comment count towards the community average, without your name."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A pontszámod és a megjegyzésed neved nélkül bekerül a közösségi átlagba."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Note und dein Kommentar fließen ohne deinen Namen in den Durchschnitt der Community ein."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta note et ton commentaire comptent dans la moyenne de la communauté, sans ton nom."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo voto e il tuo commento entrano nella media della community, senza il tuo nome."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu nota y tu comentario cuentan en la media de la comunidad, sin tu nombre."
          }
        }
      }
    },

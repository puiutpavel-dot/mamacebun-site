            "value": "Ya fui"
          }
        }
      }
    },
    "Apasă „Vreau să merg” în fișa unui local ca să-ți faci traseul de weekend.": {
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Apasă „Vreau să merg” în fișa unui local ca să-ți faci traseul de weekend."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap “Want to go” on a place to plan your weekend route."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppints a „Szeretnék menni” gombra egy hely adatlapján, és állítsd össze a hétvégi útitervedet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe bei einem Lokal auf „Will ich hin“, um deine Wochenendroute zu planen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez « Je veux y aller » sur la fiche d'un lieu pour préparer votre parcours du week-end."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca «Voglio andarci» nella scheda di un locale per pianificare il percorso del weekend."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca «Quiero ir» en la ficha de un local para planear tu ruta del fin de semana."
          }
        }
      }
    },

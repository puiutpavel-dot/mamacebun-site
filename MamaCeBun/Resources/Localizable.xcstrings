    "Acră cât trebuie și cu mult usturoi.": {
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acră cât trebuie și cu mult usturoi."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Just sour enough, with plenty of garlic."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Épp elég savanyú, sok fokhagymával."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Genau richtig säuerlich und mit viel Knoblauch."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Juste assez acidulée, avec beaucoup d'ail."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Acidula al punto giusto e con tanto aglio."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con la acidez justa y mucho ajo."
          }
        }
      }
    },

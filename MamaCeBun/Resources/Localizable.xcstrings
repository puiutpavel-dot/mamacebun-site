    "Șterge notele și comentariile tale de pe acest telefon și de pe server. Nu poate fi anulat.": {
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Șterge notele și comentariile tale de pe acest telefon și de pe server. Nu poate fi anulat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deletes your ratings and comments from this phone and from the server. This can’t be undone."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Törli az értékeléseidet és hozzászólásaidat erről a telefonról és a szerverről. Nem vonható vissza."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Löscht deine Bewertungen und Kommentare von diesem Telefon und vom Server. Kann nicht rückgängig gemacht werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprime vos notes et commentaires de ce téléphone et du serveur. Action irréversible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina i tuoi voti e commenti da questo telefono e dal server. Non si può annullare."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina tus notas y comentarios de este teléfono y del servidor. No se puede deshacer."
          }
        }
      }
    },
